# Configuración de Entorno Local
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Servicio Mock API
MOCK_API_BASE_URL=http://localhost:8080/api

# Proveedor de IA (Ej. OpenAI, Anthropic, Local)
AI_PROVIDER=openai
AI_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=your_api_key_here
# Si se usa otro proveedor:
# ANTHROPIC_API_KEY=your_api_key_here
