# Configuración de Entorno Local
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# Servicio Mock API
MOCK_API_BASE_URL=http://localhost:8080
MOCK_API_TOKEN=replace_with_mock_token

# Proveedor de IA. `dummy` permite ejecutar la prueba sin servicio externo.
AI_PROVIDER=dummy
AI_MODEL_NAME=gpt-4o-mini
# Para un proveedor compatible con OpenAI use AI_PROVIDER=openai_compatible.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=replace_with_real_key

# RAG local
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Etapa 4: protección de costo. El 100 % fuerza RAG extractivo y escalamiento.
MONTHLY_AI_BUDGET_USD=25
